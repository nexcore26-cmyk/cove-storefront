                            <span
                              className="w-4 h-4 rounded-full border flex-shrink-0"
                              style={{ borderColor: active ? '#9D7D39' : '#CFC7BA', backgroundColor: active ? '#9D7D39' : 'transparent' }}
                            />
                          </button>
                        );
                      })}
                    </div>
                  ) : (
                    <p className="text-xs" style={{ color: '#8A8A82', fontFamily: 'Montserrat, sans-serif' }}>
                      Loading the available payment options. If none are returned, the secure card page remains available.
                    </p>
                  )}

                  <p className="text-[11px] mt-4 leading-relaxed" style={{ color: '#8A8A82', fontFamily: 'Montserrat, sans-serif' }}>
                    Options are synchronized from MyFatoorah for this order amount. Apple Pay or KNET will appear only when enabled by MyFatoorah for the current checkout.
                  </p>
                </div>
              )}

          </div>
        </div>
      </div>
    </Layout>
  );
}
