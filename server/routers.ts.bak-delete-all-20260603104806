          .limit(1);
        if (!menu) continue;
        const items = await db.select().from(navigationMenuItems)
          .where(and(eq(navigationMenuItems.menuId, menu.id), eq(navigationMenuItems.isVisible, true)))
          .orderBy(asc(navigationMenuItems.sortOrder), asc(navigationMenuItems.id));
        result[menuKey] = { ...menu, items };
      }
      return result;
    }),

  listMenus: adminProcedure.query(async () => {
    const { getDb } = await import('./db');
    const { navigationMenus } = await import('../drizzle/schema');
    const { asc } = await import('drizzle-orm');
    const db = await getDb();
    if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });
    return db.select().from(navigationMenus).orderBy(asc(navigationMenus.location), asc(navigationMenus.name));
  }),

  seedDefaults: adminProcedure.mutation(async () => {
    const { getDb } = await import('./db');
    const { navigationMenus, navigationMenuItems } = await import('../drizzle/schema');
    const { eq } = await import('drizzle-orm');
    const db = await getDb();
    if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });

    const defaults = [
      {
        key: 'header',
        name: 'Header Navigation',
        location: 'header' as const,
        items: [
          { label: 'Collections', labelAr: 'المجموعات', href: '/pages/collections', sortOrder: 0 },
          { label: 'Company Portfolio', labelAr: 'معرض الأعمال', href: '/pages/projects', sortOrder: 1 },
          { label: 'Client Services', labelAr: 'خدمات العملاء', href: '/pages/client-services', sortOrder: 2 },
          { label: 'About', labelAr: 'عن كوف', href: '/pages/about', sortOrder: 3 },
          { label: 'Events', labelAr: 'الفعاليات', href: '/pages/events', sortOrder: 4 },
          { label: 'Contact', labelAr: 'اتصل بنا', href: '/pages/contact', sortOrder: 5 },
        ],
      },
      {
        key: 'footer',
        name: 'Footer Navigation',
        location: 'footer' as const,
        items: [
          { label: 'All Products', labelAr: null, href: '/shop', sortOrder: 0 },
          { label: 'Track Your Order', labelAr: null, href: '/track-order', sortOrder: 1 },
          { label: 'Shipping & Delivery', labelAr: null, href: '/shipping', sortOrder: 2 },
          { label: 'Returns & Exchanges', labelAr: null, href: '/returns', sortOrder: 3 },
          { label: 'Privacy Policy', labelAr: null, href: '/privacy', sortOrder: 4 },
          { label: 'Terms of Service', labelAr: null, href: '/terms', sortOrder: 5 },
        ],
      },
    ];

    for (const menuDefault of defaults) {
      let [menu] = await db.select().from(navigationMenus).where(eq(navigationMenus.key, menuDefault.key)).limit(1);
      if (!menu) {
        const result: any = await db.insert(navigationMenus).values({
          key: menuDefault.key,
          name: menuDefault.name,
          location: menuDefault.location,
          isActive: true,
        });
        const insertId = Number(result?.[0]?.insertId || result?.insertId || 0);
        [menu] = insertId
          ? await db.select().from(navigationMenus).where(eq(navigationMenus.id, insertId)).limit(1)
          : await db.select().from(navigationMenus).where(eq(navigationMenus.key, menuDefault.key)).limit(1);
      }
      if (!menu) continue;
      const existingItems = await db.select().from(navigationMenuItems).where(eq(navigationMenuItems.menuId, menu.id)).limit(1);
      if (existingItems.length === 0) {
        await db.insert(navigationMenuItems).values(menuDefault.items.map(item => ({
          menuId: menu.id,
          parentId: null,
          label: item.label,
          labelAr: item.labelAr,
          href: item.href,
          target: 'self' as const,
          sortOrder: item.sortOrder,
          isVisible: true,
          icon: null,
        })));
      }
    }
    return { success: true };
  }),

  createMenu: adminProcedure
    .input(z.object({
      key: menuKeyInput,
      name: z.string().min(1).max(160),
      location: menuLocationInput.default('custom'),
      isActive: z.boolean().default(true),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { navigationMenus } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });
      const [existing] = await db.select().from(navigationMenus).where(eq(navigationMenus.key, input.key)).limit(1);
      if (existing) throw new TRPCError({ code: 'CONFLICT', message: 'A menu with this key already exists' });
      await db.insert(navigationMenus).values(input);
      return { success: true };
    }),

  getMenu: adminProcedure
    .input(z.object({ key: z.string().min(1).max(80).default('header') }))
    .query(async ({ input }) => {
      const { getDb } = await import('./db');
      const { navigationMenus, navigationMenuItems } = await import('../drizzle/schema');
      const { eq, asc } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });
      let [menu] = await db.select().from(navigationMenus).where(eq(navigationMenus.key, input.key)).limit(1);
      if (!menu && input.key === 'header') {
        const result: any = await db.insert(navigationMenus).values({ key: 'header', name: 'Header Navigation', location: 'header', isActive: true });
        const insertId = Number(result?.[0]?.insertId || result?.insertId || 0);
        [menu] = insertId
          ? await db.select().from(navigationMenus).where(eq(navigationMenus.id, insertId)).limit(1)
          : await db.select().from(navigationMenus).where(eq(navigationMenus.key, 'header')).limit(1);
      }
      if (!menu) return null;
      const items = await db.select().from(navigationMenuItems)
        .where(eq(navigationMenuItems.menuId, menu.id))
        .orderBy(asc(navigationMenuItems.sortOrder), asc(navigationMenuItems.id));
      return { ...menu, items };
    }),

  updateMenu: adminProcedure
    .input(z.object({
      id: z.number().int().positive(),
      name: z.string().min(1).max(160),
      location: menuLocationInput.default('header'),
      isActive: z.boolean().default(true),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { navigationMenus } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });
      await db.update(navigationMenus).set({ name: input.name, location: input.location, isActive: input.isActive }).where(eq(navigationMenus.id, input.id));
      return { success: true };
    }),

  createItem: adminProcedure.input(menuItemInput.omit({ id: true })).mutation(async ({ input }) => {
    const { getDb } = await import('./db');
    const { navigationMenuItems } = await import('../drizzle/schema');
    const { and, eq } = await import('drizzle-orm');
    const db = await getDb();
    if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });
    if (input.parentId) {
      const [parent] = await db.select().from(navigationMenuItems)
        .where(and(eq(navigationMenuItems.id, input.parentId), eq(navigationMenuItems.menuId, input.menuId)))
        .limit(1);
      if (!parent) throw new TRPCError({ code: 'BAD_REQUEST', message: 'Parent item must belong to the same menu' });
    }
    await db.insert(navigationMenuItems).values({ ...input, labelAr: input.labelAr || null, parentId: input.parentId || null, icon: input.icon || null });
    return { success: true };
  }),

  updateItem: adminProcedure.input(menuItemInput.extend({ id: z.number().int().positive() })).mutation(async ({ input }) => {
    const { getDb } = await import('./db');
    const { navigationMenuItems } = await import('../drizzle/schema');
    const { and, eq } = await import('drizzle-orm');
    const db = await getDb();
    if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });
    const { id, ...values } = input;
    if (values.parentId === id) throw new TRPCError({ code: 'BAD_REQUEST', message: 'A menu item cannot be its own parent' });
    if (values.parentId) {
      const [parent] = await db.select().from(navigationMenuItems)
        .where(and(eq(navigationMenuItems.id, values.parentId), eq(navigationMenuItems.menuId, values.menuId)))
        .limit(1);
      if (!parent) throw new TRPCError({ code: 'BAD_REQUEST', message: 'Parent item must belong to the same menu' });
    }
    await db.update(navigationMenuItems).set({ ...values, labelAr: values.labelAr || null, parentId: values.parentId || null, icon: values.icon || null }).where(eq(navigationMenuItems.id, id));
    return { success: true };
  }),

  reorderItems: adminProcedure
    .input(z.object({
      menuId: z.number().int().positive(),
      items: z.array(z.object({
        id: z.number().int().positive(),
        parentId: z.number().int().positive().nullable(),
        sortOrder: z.number().int().min(0),
      })).max(500),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { navigationMenuItems } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });

      const existing = await db.select().from(navigationMenuItems).where(eq(navigationMenuItems.menuId, input.menuId));
      const existingIds = new Set(existing.map(item => item.id));
      const updateIds = new Set(input.items.map(item => item.id));
      const parentById = new Map(input.items.map(item => [item.id, item.parentId]));

      for (const item of input.items) {
        if (!existingIds.has(item.id)) throw new TRPCError({ code: 'BAD_REQUEST', message: 'All reordered items must belong to the selected menu' });
        if (item.parentId !== null && !existingIds.has(item.parentId)) throw new TRPCError({ code: 'BAD_REQUEST', message: 'Parent item must belong to the selected menu' });
        if (item.parentId === item.id) throw new TRPCError({ code: 'BAD_REQUEST', message: 'A menu item cannot be its own parent' });
      }

      for (const item of input.items) {
        const seen = new Set<number>();
        let parentId = item.parentId;
        while (parentId !== null) {
          if (seen.has(parentId) || parentId === item.id) throw new TRPCError({ code: 'BAD_REQUEST', message: 'Menu nesting cannot contain cycles' });
          seen.add(parentId);
          parentId = updateIds.has(parentId) ? (parentById.get(parentId) ?? null) : (existing.find(existingItem => existingItem.id === parentId)?.parentId ?? null);
        }
      }

      for (const item of input.items) {
        await db.update(navigationMenuItems)
          .set({ parentId: item.parentId, sortOrder: item.sortOrder })
          .where(eq(navigationMenuItems.id, item.id));
      }
      return { success: true };
    }),

  deleteItem: adminProcedure.input(z.object({ id: z.number().int().positive() })).mutation(async ({ input }) => {
    const { getDb } = await import('./db');
    const { navigationMenuItems } = await import('../drizzle/schema');
    const { eq, inArray } = await import('drizzle-orm');
    const db = await getDb();
    if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Database unavailable' });
    const [item] = await db.select().from(navigationMenuItems).where(eq(navigationMenuItems.id, input.id)).limit(1);
    if (!item) return { success: true };
    const allItems = await db.select().from(navigationMenuItems).where(eq(navigationMenuItems.menuId, item.menuId));
    const idsToDelete = new Set<number>([input.id]);
    let changed = true;
    while (changed) {
      changed = false;
      for (const candidate of allItems) {
        if (candidate.parentId && idsToDelete.has(candidate.parentId) && !idsToDelete.has(candidate.id)) {
          idsToDelete.add(candidate.id);
          changed = true;
        }
      }
    }
    await db.delete(navigationMenuItems).where(inArray(navigationMenuItems.id, Array.from(idsToDelete)));
    return { success: true, deletedCount: idsToDelete.size };
  }),
});

export const appRouter = router({
  vendor: vendorPortalRouter,
  system: systemRouter,
  auth: router({
    me: publicProcedure.query(opts => opts.ctx.user),
    logout: publicProcedure.mutation(({ ctx }) => {
      const cookieOptions = getSessionCookieOptions(ctx.req);
      ctx.res.clearCookie(COOKIE_NAME, { ...cookieOptions, maxAge: -1 });
      return { success: true } as const;
    }),
    /**
     * Staff login: username + password → session cookie.
     * Used by admin.coveinterior.com and pos.coveinterior.com.
     * Staff users have openId = 'staff:<username>'.
     */
    staffLogin: publicProcedure
      .input(z.object({
        username: z.string().min(1).max(64),
        password: z.string().min(1).max(128),
      }))
      .mutation(async ({ input, ctx }) => {
        const { getUserByUsername } = await import('./db');
        const user = await getUserByUsername(input.username);
        if (!user || !user.passwordHash) {
          throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Invalid username or password' });
        }
        const valid = await bcrypt.compare(input.password, user.passwordHash);
        if (!valid) {
          throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Invalid username or password' });
        }
        // Only allow staff roles to log in via this endpoint
        if (user.role === 'user') {
          throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied' });
        }
        // Create session token
        const sessionToken = await sdk.createSessionToken(user.openId, {
          name: user.name || user.openId,
          expiresInMs: ONE_YEAR_MS,
        });
        const cookieOptions = getSessionCookieOptions(ctx.req);
        ctx.res.cookie(COOKIE_NAME, sessionToken, { ...cookieOptions, maxAge: ONE_YEAR_MS });
        // Update lastSignedIn
        const { getDb } = await import('./db');
        const { users: usersTable } = await import('../drizzle/schema');
        const { eq } = await import('drizzle-orm');
        const db = await getDb();
        if (db) await db.update(usersTable).set({ lastSignedIn: new Date() }).where(eq(usersTable.id, user.id));
        return { success: true, role: user.role, name: user.name };
      }),
    /**
     * Admin sets or resets a staff member's password.
     * Can also create a new staff user.
     */
    setStaffPassword: adminProcedure
      .input(z.object({
        username: z.string().min(2).max(64).regex(/^[a-z0-9_]+$/, 'Username must be lowercase letters, numbers, or underscores'),
        password: z.string().min(8).max(128),
        name: z.string().min(1).max(255).optional(),
        role: z.enum(['admin', 'pos', 'orders']).default('pos'),
      }))
      .mutation(async ({ input }) => {
        const { getDb } = await import('./db');
        const { users: usersTable } = await import('../drizzle/schema');
        const { eq } = await import('drizzle-orm');
        const db = await getDb();
        if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
        const openId = `staff:${input.username.toLowerCase().trim()}`;
        const passwordHash = await bcrypt.hash(input.password, 12);
        const existing = await db.select().from(usersTable).where(eq(usersTable.openId, openId)).limit(1);
        if (existing.length > 0) {
          // Update existing staff user
          await db.update(usersTable)
            .set({ passwordHash, role: input.role, ...(input.name ? { name: input.name } : {}) })
            .where(eq(usersTable.openId, openId));
        } else {
          // Create new staff user
          await db.insert(usersTable).values({
            openId,
            name: input.name || input.username,
            role: input.role,
            passwordHash,
            loginMethod: 'password',
            lastSignedIn: new Date(),
          });
        }
        return { success: true };
      }),
  }),
  media: mediaRouter,
  categories: categoriesRouter,
  products: productsRouter,
  inventory: inventoryRouter,
  orders: ordersRouter,
  coupons: couponsRouter,
  shipping: shippingRouter,
  wishlist: wishlistRouter,
  pos: posRouter,
  translations: translationsRouter,
  bundles: bundlesRouter,
  attributes: attributesRouter,
  settings: settingsRouter,
  payment: paymentRouter,
  cms: cmsRouter,
  analytics: analyticsRouter,
  users: usersRouter,
  pageBuilder: pageBuilderRouter,
  headerSettings: headerSettingsRouter,
  footerSettings: footerSettingsRouter,
  menuBuilder: menuBuilderRouter,
  vendors: vendorsRouter,
  expenses: expensesRouter,
  customBox: customBoxRouter,
  cart: cartRouter,
  returnRequests: returnRequestsRouter,
  customers: customersRouter,
});

