const customBoxRouter = router({
  getConfig: adminProcedure
    .input(z.object({ productId: z.number() }))
    .query(async ({ input }) => {
      const { eq } = await import('drizzle-orm');
      const { getDb } = await import('./db');
      const { products: productsTable } = await import('../drizzle/schema');
      const db = await getDb();
      if (!db) return null;
      const [product] = await db.select({ customBoxConfig: productsTable.customBoxConfig })
        .from(productsTable)
        .where(eq(productsTable.id, input.productId));
      return (product?.customBoxConfig as any) ?? null;
    }),

  setConfig: adminProcedure
    .input(z.object({
      productId: z.number(),
      minItems: z.number().int().min(1).default(1),
      maxItems: z.number().int().min(1).default(10),
      allowedVariantIds: z.array(z.number()).default([]),
    }))
    .mutation(async ({ input }) => {
      const { eq } = await import('drizzle-orm');
      const { getDb } = await import('./db');
      const { products: productsTable } = await import('../drizzle/schema');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const config = { minItems: input.minItems, maxItems: input.maxItems, allowedVariantIds: input.allowedVariantIds };
      await db.update(productsTable).set({ customBoxConfig: config as any }).where(eq(productsTable.id, input.productId));
      return { success: true };
    }),

  getVariants: adminProcedure
    .input(z.object({ productId: z.number() }))
    .query(async ({ input }) => {
      const { eq } = await import('drizzle-orm');
      const { getDb } = await import('./db');
      const { productVariants: pvTable } = await import('../drizzle/schema');
      const db = await getDb();
      if (!db) return [];
      return db.select({
        id: pvTable.id,
        name: pvTable.name,
        sku: pvTable.sku,
        price: pvTable.price,
        image: pvTable.image,
        isActive: pvTable.isActive,
      }).from(pvTable)
        .where(eq(pvTable.productId, input.productId));
    }),
  // Public: fetch allowed variants for a custom_box product (for storefront UI)
  getBoxItems: publicProcedure
    .input(z.object({ productId: z.number() }))
    .query(async ({ input }) => {
      const { eq, inArray, and } = await import('drizzle-orm');
      const { getDb } = await import('./db');
      const { products: prodTable, productVariants: pvTable, warehouseStock, warehouses: whTable } = await import('../drizzle/schema');
      const db = await getDb();
      if (!db) return { config: null, items: [] };
      // Get the box config
      const [product] = await db.select({ customBoxConfig: prodTable.customBoxConfig })
        .from(prodTable).where(eq(prodTable.id, input.productId));
      const config = (product?.customBoxConfig as { minItems: number; maxItems: number; allowedVariantIds: number[] } | null) ?? null;
      if (!config || config.allowedVariantIds.length === 0) return { config, items: [] };
      // Get the online warehouse
      const [onlineWh] = await db.select({ id: whTable.id }).from(whTable)
        .where(eq(whTable.type, 'online')).limit(1);
      const warehouseId = onlineWh?.id;
      // Fetch allowed variants with their product info
      const variants = await db.select({
        variantId: pvTable.id,
        variantName: pvTable.name,
        variantSku: pvTable.sku,
        variantPrice: pvTable.price,
        variantImage: pvTable.image,
        productId: prodTable.id,
        productName: prodTable.name,
        productSlug: prodTable.slug,
        productImages: prodTable.images,
      }).from(pvTable)
        .innerJoin(prodTable, eq(prodTable.id, pvTable.productId))
        .where(inArray(pvTable.id, config.allowedVariantIds));
      // Enrich with stock
      const items = await Promise.all(variants.map(async (v) => {
        let stock = 999;
        if (warehouseId) {
          const [stockRow] = await db.select({ quantity: warehouseStock.quantity, reservedQty: warehouseStock.reservedQty })
            .from(warehouseStock)
            .where(and(
              eq(warehouseStock.warehouseId, warehouseId),
              eq(warehouseStock.productId, v.productId),
              eq(warehouseStock.variantId, v.variantId)
            )).limit(1);
          if (stockRow) stock = stockRow.quantity - (stockRow.reservedQty ?? 0);
        }
        return { ...v, stock };
      }));
      return { config, items };
    }),
});

