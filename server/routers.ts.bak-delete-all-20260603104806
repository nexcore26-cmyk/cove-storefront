  getCommissionTracking: adminProcedure
    .input(z.object({ status: z.enum(["all", "pending", "paid"]).optional() }))
    .query(async ({ ctx, input }) => {
      const { getDb } = await import("./db");
      const { orders, orderItems, productVendors, vendors } = await import("../drizzle/schema");
      const { and, eq } = await import("drizzle-orm");
      const db = await getDb();
      if (!db) return [];
      const commissions = new Map<number, any>();
      const allOrders = await db.select().from(orders);
      for (const order of allOrders) {
        const items = await db.select().from(orderItems).where(eq(orderItems.orderId, order.id));
        for (const item of items) {
          if (!item.productId) continue;
          const pv = await db.select().from(productVendors).where(eq(productVendors.productId, item.productId)).limit(1);
          if (pv.length === 0) continue;
          const vendor = await db.select().from(vendors)
            .where(and(eq(vendors.id, pv[0].vendorId), eq(vendors.tenantId, ctx.user!.tenantId)))
            .limit(1);
          if (vendor.length === 0) continue;
          const vendorId = vendor[0].id;
          const commissionPercent = parseFloat(pv[0].commissionPercent || "0");
          const commissionAmount = (Number(item.totalPrice ?? 0) * commissionPercent) / 100;
          if (!commissions.has(vendorId)) {
            commissions.set(vendorId, {
              vendorId,
              vendorName: vendor[0].name,
              email: vendor[0].email,
              commissionAmount: 0,
              status: vendor[0].isPaid ? "paid" : "pending",
            });
          }
          commissions.get(vendorId).commissionAmount += commissionAmount;
        }
      }
      const result = Array.from(commissions.values());
      if (input?.status === "pending") return result.filter(c => c.status === "pending");
      if (input?.status === "paid") return result.filter(c => c.status === "paid");
      return result;
    }),
  getCommissionSummary: adminProcedure.query(async ({ ctx }) => {
    const { getDb } = await import("./db");
    const { orders, orderItems, productVendors, vendors } = await import("../drizzle/schema");
    const { and, eq } = await import("drizzle-orm");
    const db = await getDb();
    if (!db) return { totalEarned: 0, totalPending: 0, totalPaid: 0 };
    let totalEarned = 0, totalPending = 0, totalPaid = 0;
    const allOrders = await db.select().from(orders);
    for (const order of allOrders) {
      const items = await db.select().from(orderItems).where(eq(orderItems.orderId, order.id));
      for (const item of items) {
        if (!item.productId) continue;
        const pv = await db.select().from(productVendors).where(eq(productVendors.productId, item.productId)).limit(1);
        if (pv.length === 0) continue;
        const vendor = await db.select().from(vendors)
          .where(and(eq(vendors.id, pv[0].vendorId), eq(vendors.tenantId, ctx.user!.tenantId)))
          .limit(1);
        if (vendor.length === 0) continue;
        const commissionPercent = parseFloat(pv[0].commissionPercent || "0");
        const commissionAmount = (Number(item.totalPrice ?? 0) * commissionPercent) / 100;
        totalEarned += commissionAmount;
        if (vendor[0].isPaid) totalPaid += commissionAmount;
        else totalPending += commissionAmount;
      }
    }
    return { totalEarned, totalPending, totalPaid };
  }),
  markAsPaid: adminProcedure
    .input(z.object({ vendorId: z.number() }))
    .mutation(async ({ ctx, input }) => {
      const { getDb } = await import("./db");
      const { vendors } = await import("../drizzle/schema");
