      return { success: true };
    }),

  /**
   * Calculate shipping cost for a cart.
   * Kuwait: base delivery cost + city surcharge + shipping class costs per item
   * GCC: sum of (shippingClass.gccCostPerUnit x qty) per cart item
   * Returns supported:false if no shipping zone found for the country.
   */
  calculateCart: publicProcedure
    .input(z.object({
      country: z.string().min(2).max(2),
      kuwaitCityId: z.number().optional(),
      items: z.array(z.object({
        productId: z.number(),
        qty: z.number().min(1),
        shippingClassId: z.number().optional().nullable(),
        kuwaitOnly: z.boolean().optional(),
      })),
    }))
    .query(async ({ input }) => {
      const { getDb } = await import('./db');
      const { shippingClasses, kuwaitCitySurcharges, shippingZones, storeSettings } = await import('../drizzle/schema');
      const { eq, inArray } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'DB unavailable' });

      const zones = await db.select().from(shippingZones);
      const matchingZone = zones.find(z =>
        Array.isArray(z.countries) && (z.countries as string[]).includes(input.country)
      );

      if (!matchingZone) {
        return { supported: false, total: 0, breakdown: [], message: 'Shipping not available for this country' };
      }

      const isKuwait = input.country === 'KW';

      // Check Kuwait-only items for GCC orders
      if (!isKuwait) {
        const kuwaitOnlyItems = input.items.filter(i => i.kuwaitOnly).map(i => i.productId);
        if (kuwaitOnlyItems.length > 0) {
          return {
            supported: false,
            total: 0,
            breakdown: [],
            kuwaitOnlyProductIds: kuwaitOnlyItems,
            message: 'Some items in your cart can only be shipped to Kuwait',
          };
        }
      }

      const classIds = input.items.map(i => i.shippingClassId).filter(Boolean) as number[];
      const classMap: Record<number, any> = {};
      if (classIds.length > 0) {
        const classes = await db.select().from(shippingClasses).where(inArray(shippingClasses.id, classIds));
        for (const c of classes) classMap[c.id] = c;
      }

      const [settings] = await db.select().from(storeSettings).limit(1);
      const kuwaitBaseCost = parseFloat(String(settings?.kuwaitBaseDeliveryCost ?? '2.000'));

      const breakdown: Array<{ label: string; cost: number }> = [];
      let total = 0;

      if (isKuwait) {
        breakdown.push({ label: 'Kuwait Delivery', cost: kuwaitBaseCost });
        total += kuwaitBaseCost;

        if (input.kuwaitCityId) {
          const [city] = await db.select().from(kuwaitCitySurcharges)
            .where(eq(kuwaitCitySurcharges.id, input.kuwaitCityId)).limit(1);
          if (city) {
            const citySurcharge = parseFloat(String(city.surcharge));
            if (citySurcharge > 0) {
              breakdown.push({ label: `${city.cityName} area surcharge`, cost: citySurcharge });
              total += citySurcharge;
            }
          }
        }

        for (const item of input.items) {
          if (item.shippingClassId) {
            const sc = classMap[item.shippingClassId];
            if (sc) {
              const itemCost = parseFloat(String(sc.kuwaitCost)) * item.qty;
              if (itemCost > 0) {
                breakdown.push({ label: `${sc.name} (x${item.qty})`, cost: itemCost });
                total += itemCost;
              }
            }
          }
        }
      } else {
        for (const item of input.items) {
          if (item.shippingClassId) {
            const sc = classMap[item.shippingClassId];
            if (sc) {
              const itemCost = parseFloat(String(sc.gccCostPerUnit)) * item.qty;
              if (itemCost > 0) {
                breakdown.push({ label: `${sc.name} (x${item.qty})`, cost: itemCost });
                total += itemCost;
              }
            }
          }
        }
      }

      return {
        supported: true,
        total: parseFloat(total.toFixed(3)),
        breakdown,
        zoneName: matchingZone.name,
        isKuwait,
      };
    }),
});

