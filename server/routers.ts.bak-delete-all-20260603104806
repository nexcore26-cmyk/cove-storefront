      let translated = 0;
      let failed = 0;
      for (const product of untranslated) {
        try {
          const response = await invokeLLM({
            messages: [
              { role: 'system', content: 'You are a professional Arabic translator for luxury home decor. Respond with valid JSON only.' },
              { role: 'user', content: `Translate to Arabic for Gulf market. Return JSON with fields: name, shortDescription, description.\nProduct: ${product.name}\nShort: ${product.shortDescription || ''}\nDesc: ${product.description || ''}` },
            ],
            response_format: {
              type: 'json_schema',
              json_schema: {
                name: 'arabic_translation',
                strict: true,
                schema: {
                  type: 'object',
                  properties: { name: { type: 'string' }, shortDescription: { type: 'string' }, description: { type: 'string' } },
                  required: ['name', 'shortDescription', 'description'],
                  additionalProperties: false,
                },
              },
            },
          });
          const content = response.choices?.[0]?.message?.content;
          if (!content) { failed++; continue; }
          const result = typeof content === 'string' ? JSON.parse(content) : content;
          await db.insert(productTranslations).values({
            productId: product.id,
            locale: 'ar',
            name: result.name,
            description: result.description,
            shortDescription: result.shortDescription,
          });
          translated++;
        } catch {
          failed++;
        }
      }
      return { translated, failed, total: untranslated.length };
    }),
});


const paymentRouter = router({
  /**
   * Initiate a payment for an existing Cove order. The order is already created;
   * this step creates the provider invoice/hosted payment and stores references.
   */
  initiate: publicProcedure
    .input(z.object({
      orderId: z.number(),
      origin: z.string().url(),
      paymentMethodId: z.number().int().positive().optional(),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { orders, orderItems } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const { initiatePayment } = await import('./payment');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const [order] = await db.select().from(orders).where(eq(orders.id, input.orderId)).limit(1);
      if (!order) throw new TRPCError({ code: 'NOT_FOUND', message: 'Order not found' });

      const items = await db.select().from(orderItems).where(eq(orderItems.orderId, input.orderId));
      const callbackUrl = `${input.origin}/checkout/callback?orderId=${order.id}`;
      const webhookUrl = `${input.origin}/api/payments/myfatoorah/webhook`;
      const orderTotal = parseFloat(String(order.total));
      const shippingTotal = parseFloat(String((order as any).shippingCost || 0));
      const discountTotal = parseFloat(String((order as any).discountAmount || 0));
      const paymentItems = items.map((i: any) => ({
        name: i.name,
        qty: i.quantity,
        unitPrice: parseFloat(String(i.unitPrice || i.total / i.quantity)),
      }));
      const itemSubtotal = paymentItems.reduce((sum, item) => sum + item.qty * item.unitPrice, 0);
      const reconciledItems = discountTotal <= 0 && Math.abs(itemSubtotal + shippingTotal - orderTotal) < 0.01
        ? [...paymentItems, ...(shippingTotal > 0 ? [{ name: 'Shipping', qty: 1, unitPrice: shippingTotal }] : [])]
        : undefined;

      const result = await initiatePayment({
        orderId: order.id,
        orderNumber: order.orderNumber,
        amount: orderTotal,
        currency: order.currency || 'KWD',
        customer: { name: order.customerName || 'Customer', email: order.customerEmail, phone: order.customerPhone },
        callbackUrl,
        errorUrl: `${input.origin}/checkout/callback?orderId=${order.id}&error=1`,
        webhookUrl,
        items: reconciledItems,
        paymentMethodId: input.paymentMethodId,
      });

      await db.update(orders).set({
        paymentReference: result.invoiceId || result.gatewayRef,
        gatewayRef: result.invoiceId || result.gatewayRef,
        paymentInvoiceId: result.invoiceId || result.gatewayRef,
        paymentId: result.paymentId,
        paymentMethod: result.gateway,
        paymentProviderData: result.providerData,
      } as any).where(eq(orders.id, order.id));

      return {
        paymentUrl: result.paymentUrl,
        gatewayRef: result.gatewayRef,
        invoiceId: result.invoiceId,
        gateway: result.gateway,
      };
    }),

  /**
   * Verify payment status after gateway callback. MyFatoorah appends paymentId;
   * when present we verify by PaymentId and persist all returned identifiers.
   */
  verify: publicProcedure
    .input(z.object({
      orderId: z.number(),
      paymentId: z.string().optional(),
      invoiceId: z.string().optional(),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { orders } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const { verifyPayment, applyPaymentResultToOrder } = await import('./payment');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const [order] = await db.select().from(orders).where(eq(orders.id, input.orderId)).limit(1);
      if (!order) throw new TRPCError({ code: 'NOT_FOUND', message: 'Order not found' });
      const gatewayRef = input.invoiceId || (order as any).paymentInvoiceId || order.gatewayRef || order.paymentReference;
      if (!gatewayRef && !input.paymentId) throw new TRPCError({ code: 'BAD_REQUEST', message: 'No payment reference found' });
      const result = await verifyPayment(String(gatewayRef || input.paymentId), order.paymentMethod as any, {
        paymentId: input.paymentId,
        invoiceId: input.invoiceId || (order as any).paymentInvoiceId || order.gatewayRef || undefined,
      });
      return await applyPaymentResultToOrder(order.id, result);
    }),

  /**
   * List MyFatoorah methods enabled for the current amount/currency.
   */
  listMethods: publicProcedure
    .input(z.object({
      amount: z.number().positive(),
      currency: z.string().min(3).max(8).optional(),
    }))
    .query(async ({ input }) => {
      const { listMfPaymentMethods } = await import('./payment');
      return listMfPaymentMethods({ amount: input.amount, currency: input.currency || 'KWD' });
    }),

  /**
   * Get active payment gateway from store settings.
   */
  getGateway: publicProcedure.query(async () => {
    const { getDb } = await import('./db');
    const { storeSettings } = await import('../drizzle/schema');
    const db = await getDb();
    if (!db) return { gateway: 'cod' as const };
    const [settings] = await db.select().from(storeSettings).limit(1);
    return {
      gateway: (settings?.activeGateway || 'myfatoorah') as 'myfatoorah' | 'upayment' | 'taly',
      codEnabled: !!(settings?.codEnabled),
    };
  }),
});

