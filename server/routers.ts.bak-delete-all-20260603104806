  /**
   * Refund an order:
   * 1. Call MyFatoorah MakeRefund API
   * 2. Restore stock to online warehouse (reverse of deductStockForOrder)
   * 3. Update order status to 'refunded', paymentStatus to 'refunded'
   * All steps are attempted; if MyFatoorah fails, the whole operation is aborted.
   */
  refund: adminProcedure
    .input(z.object({
      orderId: z.number(),
      amount: z.number().positive(),
      note: z.string().optional(),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { orders, orderItems: orderItemsTable, warehouseStock, warehouses: warehousesTable } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const { mfMakeRefund } = await import('./payment');
      const { notifyOwner } = await import('./_core/notification');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });

      // 1. Load order
      const [order] = await db.select().from(orders).where(eq(orders.id, input.orderId)).limit(1);
      if (!order) throw new TRPCError({ code: 'NOT_FOUND', message: 'Order not found' });
      if (order.paymentStatus === 'refunded') throw new TRPCError({ code: 'BAD_REQUEST', message: 'Order already refunded' });
      if (order.paymentStatus !== 'paid') throw new TRPCError({ code: 'BAD_REQUEST', message: 'Order has not been paid' });

      // 2. Call MyFatoorah refund (only for online orders paid via myfatoorah)
      if (order.channel === 'online' && order.paymentMethod === 'myfatoorah') {
        if (!order.gatewayRef) throw new TRPCError({ code: 'BAD_REQUEST', message: 'No gateway reference found for this order. Cannot process refund.' });
        const refundResult = await mfMakeRefund({
          gatewayRef: order.gatewayRef,
          amount: input.amount,
          comment: input.note || 'Admin refund',
        });
        if (refundResult.status === 'failed') {
          throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'MyFatoorah refund failed: ' + (refundResult.message || 'Unknown error') });
        }
        // Store refund details
        await db.update(orders).set({
          refundId: refundResult.refundId,
          refundAmount: String(input.amount),
          refundNote: input.note || null,
          refundedAt: new Date(),
          status: 'refunded',
          paymentStatus: 'refunded',
        }).where(eq(orders.id, input.orderId));
      } else {
        // COD or POS — just mark as refunded (no gateway call)
        await db.update(orders).set({
          refundAmount: String(input.amount),
          refundNote: input.note || null,
          refundedAt: new Date(),
          status: 'refunded',
          paymentStatus: 'refunded',
        }).where(eq(orders.id, input.orderId));
      }

      // 3. Restore stock to online warehouse (only for online orders)
      if (order.channel === 'online') {
        try {
          const items = await db.select().from(orderItemsTable).where(eq(orderItemsTable.orderId, input.orderId));
          const [onlineWarehouse] = await db.select().from(warehousesTable).where(eq(warehousesTable.type, 'online')).limit(1);
          if (onlineWarehouse && items.length > 0) {
            for (const item of items) {
              if (!item.productId) continue;
              const condition = item.variantId
                ? eq(warehouseStock.variantId, item.variantId)
                : eq(warehouseStock.productId, item.productId);
              const [stockRow] = await db.select().from(warehouseStock)
                .where(eq(warehouseStock.warehouseId, onlineWarehouse.id))
                .limit(1);
              if (stockRow) {
                await db.update(warehouseStock)
                  .set({ quantity: stockRow.quantity + item.quantity })
                  .where(eq(warehouseStock.id, stockRow.id));
              }
            }
          }
        } catch (stockErr: any) {
          // Stock restore failed — notify owner but don't fail the refund (money already returned)
          await notifyOwner({
            title: 'Stock restore failed after refund',
            content: `Order #${input.orderId} was refunded but stock could not be restored. Reason: ${stockErr.message}. Please adjust manually.`,
          });
        }
      }

      return { success: true };
    }),

  // P6: Exchange Workflow
  exchange: adminProcedure
    .input(z.object({
      originalOrderId: z.number(),
      newItems: z.array(z.object({
        productId: z.number(),
        variantId: z.number().optional(),
        name: z.string(),
        sku: z.string().optional(),
        quantity: z.number().int().positive(),
        price: z.number().nonnegative(),
      })).min(1),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { orders, orderItems: orderItemsTable, warehouseStock, warehouses: warehousesTable } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });

      // 1. Load original order
      const [originalOrder] = await db.select().from(orders).where(eq(orders.id, input.originalOrderId)).limit(1);
      if (!originalOrder) throw new TRPCError({ code: 'NOT_FOUND', message: 'Original order not found' });
      if (originalOrder.status === 'exchanged') throw new TRPCError({ code: 'BAD_REQUEST', message: 'Order has already been exchanged' });
      if (!['completed', 'processing', 'delivered', 'shipped'].includes(originalOrder.status)) {
        throw new TRPCError({ code: 'BAD_REQUEST', message: 'Exchange can only be performed on completed, processing, delivered, or shipped orders' });
      }

      // 2. Load original items
      const originalItems = await db.select().from(orderItemsTable).where(eq(orderItemsTable.orderId, input.originalOrderId));

      // 3. Determine warehouse to restore stock to (channel-appropriate)
      const warehouseType = originalOrder.channel === 'pos' ? 'pos' : 'online';
      const [warehouse] = await db.select().from(warehousesTable).where(eq(warehousesTable.type, warehouseType)).limit(1);

      // 4. Generate new order number
      const newOrderNumber = `EXC-${Date.now()}`;

      // 5. Calculate new order total
      const newTotal = input.newItems.reduce((sum, item) => sum + item.price * item.quantity, 0);

      // 6. Execute in transaction
      await db.transaction(async (tx) => {
        // a) Restore stock for original items
        if (warehouse) {
          for (const item of originalItems) {
            if (!item.productId) continue;
            const [stockRow] = await tx.select().from(warehouseStock)
              .where(eq(warehouseStock.warehouseId, warehouse.id))
              .limit(1);
            if (stockRow) {
              await tx.update(warehouseStock)
                .set({ quantity: stockRow.quantity + item.quantity })
                .where(eq(warehouseStock.id, stockRow.id));
            }
          }
        }

        // b) Mark original order as exchanged
        await tx.update(orders)
          .set({ status: 'exchanged' })
          .where(eq(orders.id, input.originalOrderId));

        // c) Create new linked order
        const [newOrderResult] = await tx.insert(orders).values({
          orderNumber: newOrderNumber,
          customerId: originalOrder.customerId,
          customerName: originalOrder.customerName,
          customerEmail: originalOrder.customerEmail,
          customerPhone: originalOrder.customerPhone,
          shippingCountry: originalOrder.shippingCountry,
          shippingArea: originalOrder.shippingArea,
          shippingBlock: originalOrder.shippingBlock,
          shippingStreet: originalOrder.shippingStreet,
          shippingAvenue: originalOrder.shippingAvenue,
          shippingHouse: originalOrder.shippingHouse,
          subtotal: String(newTotal),
          total: String(newTotal),
          currency: originalOrder.currency,
          status: 'processing',
          paymentStatus: 'paid',
          channel: originalOrder.channel,
          exchangedFromOrderId: input.originalOrderId,
          createdByUserId: originalOrder.createdByUserId,
        });

        const newOrderId = (newOrderResult as any).insertId;

        // d) Insert new order items
        for (const item of input.newItems) {
          await tx.insert(orderItemsTable).values({
            orderId: newOrderId,
            productId: item.productId,
            variantId: item.variantId ?? null,
            name: item.name,
            sku: item.sku ?? null,
            quantity: item.quantity,
            unitPrice: String(item.price),
            totalPrice: String(item.price * item.quantity),
          });
        }
      });

      return { success: true, newOrderNumber };
    }),

  // E1: Update internal notes (admin-only, not visible to customer)
  updateInternalNotes: ordersProcedure
