        quantity: z.number(),
        // Measurement-based quantity fields
        qtyValue: z.number().default(1),
        measurementType: z.enum(['unit', 'meter', 'kg', 'roll', 'box']).default('unit'),
        price: z.number(),
        total: z.number(),
      })),
    }))
    .mutation(async ({ input, ctx }) => {
      const { getDb } = await import("./db");
      const { customers, products: productsTable, bundleItems, warehouseStock, warehouses: warehousesTable } = await import("../drizzle/schema");
      const { eq, and } = await import("drizzle-orm");
      const db = await getDb();
      let customerId: number | undefined;
      if (ctx.user && db) {
        const custRows = await db.select().from(customers).where(eq(customers.email, ctx.user.email || ""  )).limit(1);
        customerId = custRows[0]?.id;
      }
      const result = await createOrder({
        ...input,
        customerId,
        channel: "online",
        status: "pending",
        currency: "KWD",
      });

      // Bundle stock deduction: for each ordered item whose product type is 'bundle',
      // deduct qty from each component variant in the online warehouse.
      // Note: createOrder() already deducts parent-product stock from the online warehouse;
      // for bundle products we ALSO deduct from each component variant, and we UNDO the
      // parent-product deduction (bundle products themselves don't hold stock — components do).
      if (db) {
        const [onlineWarehouse] = await db.select().from(warehousesTable).where(eq(warehousesTable.type, 'online')).limit(1);
        if (onlineWarehouse) {
          for (const item of input.items) {
            if (!item.variantId) continue;
            // Check if this product is a bundle
            const [prod] = await db.select({ type: productsTable.type }).from(productsTable)
              .where(eq(productsTable.id, item.productId)).limit(1);
            if (prod?.type !== 'bundle') continue;

            // Undo the parent-product stock deduction that createOrder() already applied
            const [parentStockRow] = await db.select().from(warehouseStock)
              .where(and(
                eq(warehouseStock.warehouseId, onlineWarehouse.id),
                eq(warehouseStock.productId, item.productId)
              )).limit(1);
            if (parentStockRow) {
              // Restore the quantity that createOrder() deducted
              await db.update(warehouseStock)
                .set({ quantity: (parentStockRow.quantity || 0) + item.quantity })
                .where(eq(warehouseStock.id, parentStockRow.id));
            }

            // Get all component variants for this bundle variant
            const components = await db.select().from(bundleItems)
              .where(eq(bundleItems.bundleVariantId, item.variantId));
            // Deduct from each component variant's stock
            for (const component of components) {
              const componentQty = parseFloat(String(component.qty)) * item.quantity;
              const [stockRow] = await db.select().from(warehouseStock)
                .where(and(
                  eq(warehouseStock.warehouseId, onlineWarehouse.id),
                  eq(warehouseStock.variantId, component.componentVariantId)
                )).limit(1);
              if (stockRow) {
                const newQty = Math.max(0, (stockRow.quantity || 0) - Math.ceil(componentQty));
                await db.update(warehouseStock).set({ quantity: newQty }).where(eq(warehouseStock.id, stockRow.id));
              }
            }
          }
        }
      }

      // Generate PDF invoice + send emails (fire-and-forget, non-blocking)
      const customerEmail = input.guestEmail || (ctx.user?.email ?? null);
      const customerName = input.guestName || (ctx.user?.name ?? 'Valued Customer');
      if (result?.orderId) {
        const emailItems = input.items.map((item: any) => ({
          productName: item.name || String(item.productId),
          variantName: null as string | null,
          quantity: item.quantity,
          unitPrice: item.price,
        }));

        // Generate PDF invoice and upload to S3
        (async () => {
          try {
            const { generateInvoicePdf } = await import('./invoice');
            const { storagePut } = await import('./storage');
            const { orders: ordersTable } = await import('../drizzle/schema');
            const { eq: eqFn } = await import('drizzle-orm');
            const dbInst = await (await import('./db')).getDb();

            const invoiceItems = input.items.map((item: any) => ({
              name: item.name || `Product #${item.productId}`,
              qty: item.quantity,
              qtyValue: item.qtyValue,
              measurementType: item.measurementType,
              unitPrice: item.price,
              lineTotal: item.total,
            }));

            const pdfBuffer = await generateInvoicePdf({
              orderNumber: String(result.orderNumber || result.orderId),
              orderDate: new Date(),
              status: 'pending',
              customerName,
              customerEmail: customerEmail || '',
              customerPhone: (input as any).phone ?? undefined,
              address: {
                country: input.billingAddress?.country || 'KW',
                area: input.billingAddress?.area,
                block: input.billingAddress?.block,
                street: input.billingAddress?.street,
                avenue: input.billingAddress?.avenue,
                house: input.billingAddress?.house,
              },
              items: invoiceItems,
              subtotal: input.subtotal,
              shippingCost: input.shippingTotal,
              discount: input.discountTotal,
              total: input.total,
              currency: 'KWD',
              paymentMethod: input.paymentMethod || 'Cash on Delivery',
            });

            const { key: invoiceKey } = await storagePut(
              `invoices/order-${result.orderNumber || result.orderId}.pdf`,
              pdfBuffer,
              'application/pdf',
            );

            // Save invoiceKey to order row
            if (dbInst) {
              await dbInst.update(ordersTable)
                .set({ invoiceKey })
