const usersRouter = router({
  list: adminProcedure
    .input(z.object({
      search: z.string().optional(),
      role: z.enum(['user', 'admin', 'pos', 'orders', 'all']).default('all'),
      limit: z.number().default(50),
      offset: z.number().default(0),
    }))
    .query(async ({ input }) => {
      const { getDb } = await import('./db');
      const { users } = await import('../drizzle/schema');
      const { like, or, eq, desc } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const conditions: any[] = [];
      if (input.search) {
        conditions.push(or(like(users.name, `%${input.search}%`), like(users.email, `%${input.search}%`)));
      }
      if (input.role !== 'all') {
        conditions.push(eq(users.role, input.role as 'user' | 'admin' | 'pos' | 'orders'));
      }
      const { and, sql: sqlFn } = await import('drizzle-orm');
      const where = conditions.length > 0 ? and(...conditions) : undefined;
      const rows = await db.select().from(users).where(where).orderBy(desc(users.createdAt)).limit(input.limit).offset(input.offset);
      const [{ total }] = await db.select({ total: sqlFn<number>`COUNT(*)` }).from(users).where(where);
      return { users: rows, total: Number(total) };
    }),

  updateRole: adminProcedure
    .input(z.object({ id: z.number(), role: z.enum(['user', 'admin', 'pos', 'orders']) }))
    .mutation(async ({ input, ctx }) => {
      const { getDb } = await import('./db');
      const { users } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      // Prevent self-demotion
      if (ctx.user.id === input.id && input.role !== 'admin') {
        throw new TRPCError({ code: 'BAD_REQUEST', message: 'Cannot change your own role' });
      }
      await db.update(users).set({ role: input.role }).where(eq(users.id, input.id));
      return { success: true };
    }),

  orderHistory: adminProcedure
    .input(z.object({ userId: z.number() }))
    .query(async ({ input }) => {
      const { getDb } = await import('./db');
      const { orders, users: usersTable, customers } = await import('../drizzle/schema');
      const { eq, desc } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      // orders table uses customerId which maps to the users table id via customers
      // For simplicity, return orders where guestEmail matches user email or customerId matches
      const [user] = await db.select({ email: usersTable.email }).from(usersTable).where(eq(usersTable.id, input.userId)).limit(1);
      if (!user) return [];
      const { like } = await import('drizzle-orm');
      const customerRows = user.email
        ? await db.select({ id: customers.id }).from(customers).where(like(customers.email, user.email)).limit(1)
        : [];
      const customerId = customerRows[0]?.id;
      const rows = customerId
        ? await db.select().from(orders).where(eq(orders.customerId, customerId)).orderBy(desc(orders.createdAt)).limit(20)
        : [];
      return rows;
    }),
});

