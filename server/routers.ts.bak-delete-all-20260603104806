const categoriesRouter = router({
  list: publicProcedure
    .input(z.object({
      channel: z.enum(['online', 'pos', 'both', 'none']).optional(),
      locale: localeSchema.optional(),
    }).optional())
    .query(async ({ input }) => {
      const cats = await getCategories(input?.channel ? { channel: input.channel } : {});
      if (!input?.locale || input.locale === 'en') return cats;
      // Overlay Arabic translations
      const { getDb } = await import('./db');
      const { categoryTranslations } = await import('../drizzle/schema');
      const { inArray, eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db || cats.length === 0) return cats;
      const ids = cats.map((c: any) => c.id);
      const translations = await db.select().from(categoryTranslations)
        .where(inArray(categoryTranslations.categoryId, ids));
      const arMap = new Map(translations.filter((t: any) => t.locale === 'ar').map((t: any) => [t.categoryId, t]));
      return cats.map((c: any) => {
        const ar = arMap.get(c.id);
        return ar ? { ...c, name: ar.name } : c;
      });
    }),
  bySlug: publicProcedure
    .input(z.object({ slug: z.string(), locale: localeSchema.optional() }))
    .query(async ({ input }) => {
      const cat = await getCategoryBySlug(input.slug);
      if (!cat || !input.locale || input.locale === 'en') return cat;
      const { getDb } = await import('./db');
      const { categoryTranslations } = await import('../drizzle/schema');
      const { and, eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) return cat;
      const [ar] = await db.select().from(categoryTranslations)
        .where(and(eq(categoryTranslations.categoryId, (cat as any).id), eq(categoryTranslations.locale, 'ar')));
      return ar ? { ...cat, name: ar.name } : cat;
    }),

  // ── Admin CRUD ──────────────────────────────────────────────────────────
  create: adminProcedure
    .input(z.object({
      name: z.string().min(1),
      nameAr: z.string().optional(),
      slug: z.string().optional(),
      parentId: z.number().optional(),
      description: z.string().optional(),
      image: z.string().optional(),
      channel: z.enum(['online', 'pos', 'both', 'none', 'web', 'store']).default('both'),
      displayOrder: z.number().default(0),
      isActive: z.boolean().default(true),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { categories: cats } = await import('../drizzle/schema');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      // Auto-generate slug if not provided
      const slug = input.slug ||
        input.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      const [result] = await db.insert(cats).values({ ...input, slug });
      return { id: (result as any).insertId };
    }),

  update: adminProcedure
    .input(z.object({
      id: z.number(),
      name: z.string().min(1).optional(),
      nameAr: z.string().optional(),
      slug: z.string().optional(),
      parentId: z.number().nullable().optional(),
      description: z.string().optional(),
      image: z.string().optional(),
      channel: z.enum(['online', 'pos', 'both', 'none', 'web', 'store']).optional(),
      displayOrder: z.number().optional(),
      isActive: z.boolean().optional(),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { categories: cats } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const { id, ...data } = input;
      await db.update(cats).set(data).where(eq(cats.id, id));
      return { success: true };
    }),

  delete: adminProcedure
    .input(z.object({ id: z.number() }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { categories: cats } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      await db.delete(cats).where(eq(cats.id, input.id));
      return { success: true };
    }),
});


const mediaRouter = router({
  list: adminProcedure
    .input(z.object({
      search: z.string().optional(),
      limit: z.number().min(1).max(200).default(80),
      entityType: z.string().optional(),
    }).optional())
    .query(async ({ ctx, input }) => {
      const { getDb } = await import('./db');
      const { mediaAssets } = await import('../drizzle/schema');
      const { and, desc, eq, like, or } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) return [];
      const tenantId = ctx.user?.tenantId ?? 1;
      const conditions: any[] = [eq(mediaAssets.tenantId, tenantId), eq(mediaAssets.isActive, true)];
      if (input?.entityType) conditions.push(eq(mediaAssets.entityType, input.entityType));
      if (input?.search) {
        const q = `%${input.search}%`;
        conditions.push(or(
          like(mediaAssets.originalFilename, q),
          like(mediaAssets.altText, q),
          like(mediaAssets.url, q),
          like(mediaAssets.key, q),
        ));
      }
      return db.select().from(mediaAssets)
        .where(and(...conditions))
        .orderBy(desc(mediaAssets.createdAt))
        .limit(input?.limit ?? 80);
    }),

  upload: adminProcedure
    .input(z.object({
      fileDataUrl: z.string().optional(),
      imageDataUrl: z.string().optional(),
      filename: z.string().optional(),
      mimeType: z.string().optional(),
      altText: z.string().optional(),
      entityType: z.string().optional(),
      entityId: z.number().optional(),
      duplicateAction: z.enum(['error', 'replace', 'rename']).optional().default('error'),
    }))
    .mutation(async ({ ctx, input }) => {
      const dataUrl = input.fileDataUrl || input.imageDataUrl;
      if (!dataUrl) throw new TRPCError({ code: 'BAD_REQUEST', message: 'Missing media file data' });
      const matches = dataUrl.match(/^data:([^;]+);base64,(.+)$/);
      if (!matches) throw new TRPCError({ code: 'BAD_REQUEST', message: 'Invalid media data URL' });
      const mimeType = input.mimeType || matches[1] || 'application/octet-stream';
      const buffer = Buffer.from(matches[2], 'base64');
      if (buffer.length > 50 * 1024 * 1024) {
        throw new TRPCError({ code: 'BAD_REQUEST', message: 'Media file is larger than the 50 MB admin upload limit' });
      }
      const safeFilename = (input.filename || `media-${Date.now()}`)
        .replace(/[^a-zA-Z0-9._-]+/g, '-')
        .replace(/^-+|-+$/g, '') || `media-${Date.now()}`;
      const tenantId = ctx.user?.tenantId ?? 1;
      const now = new Date();
      const yyyy = String(now.getFullYear());
      const mm = String(now.getMonth() + 1).padStart(2, '0');
      const sha256 = createHash('sha256').update(buffer).digest('hex');
      const { storagePut } = await import('./storage');
      const { getDb } = await import('./db');
      const { mediaAssets } = await import('../drizzle/schema');
      const { and, eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });

      const activeTenantAssets = await db.select().from(mediaAssets)
        .where(and(
          eq(mediaAssets.tenantId, tenantId),
          eq(mediaAssets.isActive, true),
        ));
      const existingAsset = activeTenantAssets.find(
        (asset) => String(asset.originalFilename || '').toLowerCase() === safeFilename.toLowerCase(),
      );

      if (existingAsset && input.duplicateAction === 'error') {
        throw new TRPCError({
          code: 'CONFLICT',
          message: `Media Library already contains "${safeFilename}". Choose Replace to overwrite it, or Upload Copy to save a numbered filename.`,
        });
      }

      const splitFilename = (filename: string) => {
        const lastDot = filename.lastIndexOf('.');
        if (lastDot <= 0) return { base: filename, ext: '' };
        return { base: filename.slice(0, lastDot), ext: filename.slice(lastDot) };
      };
      const numberedFilename = (filename: string, usedNames: Set<string>) => {
        const { base, ext } = splitFilename(filename);
        let index = 1;
        let candidate = `${base}-${index}${ext}`;
        while (usedNames.has(candidate.toLowerCase())) {
          index += 1;
          candidate = `${base}-${index}${ext}`;
        }
        return candidate;
      };

      let finalFilename = safeFilename;
      let targetKey = `admin-uploads/tenant-${tenantId}/${yyyy}/${mm}/${safeFilename}`;
      let replaceAssetId: number | null = null;
      let preserveUrl: string | null = null;

      if (existingAsset && input.duplicateAction === 'replace') {
        replaceAssetId = Number(existingAsset.id);
        targetKey = existingAsset.key || targetKey;
        preserveUrl = existingAsset.url || null;
      } else if (existingAsset && input.duplicateAction === 'rename') {
        const usedNames = new Set(activeTenantAssets.map((asset) => String(asset.originalFilename || '').toLowerCase()).filter(Boolean));
        finalFilename = numberedFilename(safeFilename, usedNames);
        targetKey = `admin-uploads/tenant-${tenantId}/${yyyy}/${mm}/${finalFilename}`;
      }

      const stored = await storagePut(targetKey, buffer, mimeType, { naming: 'exact' });
      const asset = { ...stored, url: preserveUrl || stored.url, mimeType, sizeBytes: buffer.length, sha256 };

      if (replaceAssetId) {
        await db.update(mediaAssets).set({
          key: asset.key,
          url: asset.url,
          mimeType: asset.mimeType,
          sizeBytes: asset.sizeBytes,
          sha256: asset.sha256,
          originalFilename: finalFilename,
          altText: input.altText,
          entityType: input.entityType,
          entityId: input.entityId,
        } as any).where(eq(mediaAssets.id, replaceAssetId));
        return { id: replaceAssetId, ...asset, originalFilename: finalFilename, altText: input.altText ?? null, duplicateAction: 'replace' };
      }

      const [result] = await db.insert(mediaAssets).values({
        tenantId,
        key: asset.key,
        url: asset.url,
        sourceSystem: 'cove-admin',
        mimeType: asset.mimeType,
        sizeBytes: asset.sizeBytes,
        sha256: asset.sha256,
        originalFilename: finalFilename,
        altText: input.altText,
        entityType: input.entityType,
        entityId: input.entityId,
        isActive: true,
      } as any);
      return { id: (result as any).insertId, ...asset, originalFilename: finalFilename, altText: input.altText ?? null, duplicateAction: existingAsset ? 'rename' : 'upload' };
    }),
});

const productsRouter = router({
  list: publicProcedure
    .input(z.object({
      categoryId: z.number().optional(),
      search: z.string().optional(),
      limit: z.number().min(1).max(500).optional(),
      offset: z.number().min(0).optional(),
      featured: z.boolean().optional(),
      status: z.enum(['active', 'draft', 'archived']).optional(),
      locale: localeSchema.optional(),
    }).optional())
    .query(async ({ input }) => {
      const result = await getProducts({ ...(input || {}) });
      if (!input?.locale || input.locale === 'en') return result;
      const { getDb } = await import('./db');
      const { productTranslations } = await import('../drizzle/schema');
      const { inArray } = await import('drizzle-orm');
      const db = await getDb();
      if (!db || result.items.length === 0) return result;
      const ids = result.items.map((p: any) => p.id);
      const translations = await db.select().from(productTranslations)
        .where(inArray(productTranslations.productId, ids));
      const arMap = new Map(translations.filter((t: any) => t.locale === 'ar').map((t: any) => [t.productId, t]));
      return {
        ...result,
        items: result.items.map((p: any) => {
          const ar = arMap.get(p.id);
          return ar ? { ...p, name: ar.name, description: ar.description ?? p.description, shortDescription: ar.shortDescription ?? p.shortDescription } : p;
        }),
      };
    }),
  bySlug: publicProcedure
    .input(z.object({ slug: z.string(), locale: localeSchema.optional() }))
    .query(async ({ input }) => {
      const product = await getProductBySlug(input.slug);
      if (!product) throw new TRPCError({ code: 'NOT_FOUND', message: 'Product not found' });
      const variants = await getProductVariants(product.id);

      // For bundle products, compute effective stock per variant (min of component stocks)
      let variantsWithBundleStock = variants;
      if ((product as any).type === 'bundle') {
        const { getDb } = await import('./db');
        const { bundleItems, warehouseStock, warehouses: warehousesTable, productVariants: pvTable, products: prodTable } = await import('../drizzle/schema');
        const { eq, and } = await import('drizzle-orm');
        const db = await getDb();
        if (db) {
          // Get the online warehouse
          const [onlineWarehouse] = await db.select().from(warehousesTable)
            .where(eq(warehousesTable.type, 'online')).limit(1);
          const warehouseId = onlineWarehouse?.id;
          if (warehouseId) {
            variantsWithBundleStock = await Promise.all(
              variants.map(async (variant) => {
                const components = await db.select().from(bundleItems)
                  .where(eq(bundleItems.bundleVariantId, variant.id));
                if (components.length === 0) return { ...variant, bundleStock: null, bundleComponents: [] };
                // Compute min available units across all components, and fetch component names
                const componentStocks = await Promise.all(
                  components.map(async (comp) => {
                    const qty = parseFloat(String(comp.qty));
                    const [stockRow] = await db.select().from(warehouseStock)
                      .where(and(
                        eq(warehouseStock.warehouseId, warehouseId),
                        eq(warehouseStock.variantId, comp.componentVariantId)
                      )).limit(1);
                    const stock = stockRow?.quantity || 0;
                    // Fetch component variant + product name for display
                    const [compVariant] = await db.select({
                      variantName: pvTable.name,
                      variantSku: pvTable.sku,
                      variantImage: pvTable.image,
                      productName: prodTable.name,
                      productSlug: prodTable.slug,
                    }).from(pvTable)
                      .innerJoin(prodTable, eq(prodTable.id, pvTable.productId))
                      .where(eq(pvTable.id, comp.componentVariantId))
                      .limit(1);
                    return {
                      componentVariantId: comp.componentVariantId,
                      qty,
                      stock,
                      availableUnits: qty > 0 ? Math.floor(stock / qty) : 0,
                      variantName: compVariant?.variantName ?? null,
                      variantSku: compVariant?.variantSku ?? null,
                      variantImage: compVariant?.variantImage ?? null,
                      productName: compVariant?.productName ?? null,
                      productSlug: compVariant?.productSlug ?? null,
                    };
                  })
                );
                const effectiveStock = Math.min(...componentStocks.map((c) => c.availableUnits));
                return { ...variant, bundleStock: effectiveStock, bundleComponents: componentStocks };
              })
            );
          }
        }
      }

      // For non-bundle products, enrich each variant with its online warehouse stock
      if ((product as any).type !== 'bundle') {
        const { getDb } = await import('./db');
        const { warehouseStock, warehouses: warehousesTable } = await import('../drizzle/schema');
        const { eq, and, isNull } = await import('drizzle-orm');
        const db = await getDb();
        if (db) {
          const [onlineWarehouse] = await db.select().from(warehousesTable)
            .where(eq(warehousesTable.type, 'online')).limit(1);
          const warehouseId = onlineWarehouse?.id;
          if (warehouseId) {
            variantsWithBundleStock = await Promise.all(
              variantsWithBundleStock.map(async (variant) => {
                const [stockRow] = await db.select().from(warehouseStock)
                  .where(and(
                    eq(warehouseStock.warehouseId, warehouseId),
                    eq(warehouseStock.productId, product.id),
                    variant.id ? eq(warehouseStock.variantId, variant.id) : isNull(warehouseStock.variantId)
                  )).limit(1);
                // If no stock record exists, treat as in-stock (inventory not yet configured)
                const stock = stockRow ? (stockRow.quantity - (stockRow.reservedQty ?? 0)) : -1;
                // P7: Include pre-order fields so storefront can show pre-order badge
                const isPreOrderAvailable = variant.preOrderEnabled && variant.preOrderUsed < variant.preOrderLimit;
                return { ...variant, stock, isPreOrderAvailable };
              })
            );
          }
        }
      }

      if (!input.locale || input.locale === 'en') return { product, variants: variantsWithBundleStock };
      const { getDb } = await import('./db');
      const { productTranslations } = await import('../drizzle/schema');
      const { and, eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) return { product, variants: variantsWithBundleStock };
      const [ar] = await db.select().from(productTranslations)
        .where(and(eq(productTranslations.productId, product.id), eq(productTranslations.locale, 'ar')));
      const localizedProduct = ar ? { ...product, name: ar.name, description: ar.description ?? product.description, shortDescription: ar.shortDescription ?? product.shortDescription } : product;
      return { product: localizedProduct, variants: variantsWithBundleStock };
    }),
  variants: publicProcedure
    .input(z.object({ productId: z.number() }))
    .query(({ input }) => getProductVariants(input.productId)),
  stock: publicProcedure
    .input(z.object({ productId: z.number(), variantId: z.number().optional() }))
    .query(({ input }) => getProductStock(input.productId, input.variantId)),
  // Pricing engine: returns unitPrice × qtyValue for measurement-based products
  calculatePrice: publicProcedure
    .input(z.object({
      productId: z.number(),
      variantId: z.number().optional(),
      qtyValue: z.number().min(0.001),
    }))
    .query(async ({ input }) => {
      const { getDb } = await import('./db');
      const { products, productVariants } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      let unitPrice = 0;
      let measurementType: string = 'unit';
      if (input.variantId) {
        const [variant] = await db.select().from(productVariants).where(eq(productVariants.id, input.variantId)).limit(1);
        if (variant) unitPrice = parseFloat(String(variant.salePrice || variant.price));
      }
      if (!unitPrice) {
        const [product] = await db.select().from(products).where(eq(products.id, input.productId)).limit(1);
        if (product) {
          unitPrice = parseFloat(String(product.salePrice || product.price));
          measurementType = product.measurementType || 'unit';
        }
      }
      const totalPrice = parseFloat((unitPrice * input.qtyValue).toFixed(3));
      return { unitPrice, totalPrice, measurementType, qtyValue: input.qtyValue };
    }),
  update: adminProcedure
    .input(z.object({
      id: z.number(),
      name: z.string().optional(),
      nameAr: z.string().optional(),
      description: z.string().optional(),
      descriptionAr: z.string().optional(),
      shortDescription: z.string().optional(),
      shortDescriptionAr: z.string().optional(),
      sku: z.string().optional(),
      price: z.string().optional(),
      salePrice: z.string().optional(),
      cog: z.string().optional(),
      measurementType: z.enum(['unit', 'meter', 'kg', 'roll', 'box']).optional(),
      type: z.enum(['simple', 'variable', 'grouped', 'bundle', 'custom_box']).optional(),
      status: z.enum(['active', 'draft', 'archived']).optional(),
      isFeatured: z.boolean().optional(),
      isNew: z.boolean().optional(),
      categoryId: z.number().nullable().optional(),
      images: z.array(z.string()).optional(),
      weight: z.string().optional(),
      tags: z.array(z.string()).optional(),
      shippingClass: z.string().optional(),
      shippingClassId: z.number().nullable().optional(),
      kuwaitOnly: z.boolean().optional(),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { products } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const { id, ...data } = input;
      await db.update(products).set(data as any).where(eq(products.id, id));
      return { success: true };
    }),

  create: adminProcedure
    .input(z.object({
      name: z.string().min(1),
      nameAr: z.string().optional(),
      description: z.string().optional(),
      descriptionAr: z.string().optional(),
      shortDescription: z.string().optional(),
      shortDescriptionAr: z.string().optional(),
      sku: z.string().optional(),
      price: z.string().default('0.000'),
      salePrice: z.string().optional(),
      cog: z.string().optional(),
      measurementType: z.enum(['unit', 'meter', 'kg', 'roll', 'box']).default('unit'),
      type: z.enum(['simple', 'variable', 'grouped', 'bundle', 'custom_box']).default('simple'),
      status: z.enum(['active', 'draft', 'archived']).default('draft'),
      isFeatured: z.boolean().default(false),
      isNew: z.boolean().default(false),
      categoryId: z.number().optional(),
      images: z.array(z.string()).default([]),
      weight: z.string().optional(),
      tags: z.array(z.string()).default([]),
      shippingClass: z.string().optional(),
      shippingClassId: z.number().nullable().optional(),
      kuwaitOnly: z.boolean().default(false),
    }))
    .mutation(async ({ input }) => {
      const { getDb } = await import('./db');
      const { products } = await import('../drizzle/schema');
      const { like } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const baseSlug = input.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/, '');
      const existing = await db.select({ slug: products.slug }).from(products).where(like(products.slug, `${baseSlug}%`));
      const slug = existing.length === 0 ? baseSlug : `${baseSlug}-${Date.now()}`;
      const [result] = await db.insert(products).values({ ...input, slug } as any);
      return { id: (result as any).insertId, slug };
    }),

  byId: adminProcedure
    .input(z.object({ id: z.number() }))
    .query(async ({ input }) => {
      const { getDb } = await import('./db');
      const { products, productVariants } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const [product] = await db.select().from(products).where(eq(products.id, input.id)).limit(1);
      if (!product) throw new TRPCError({ code: 'NOT_FOUND', message: 'Product not found' });
      const variants = await db.select().from(productVariants).where(eq(productVariants.productId, input.id));
      return { product, variants };
    }),

  uploadImage: adminProcedure
    .input(z.object({
      productId: z.number(),
      imageDataUrl: z.string(),
      filename: z.string().optional(),
    }))
    .mutation(async ({ input }) => {
      const { storagePut } = await import('./storage');
      const matches = input.imageDataUrl.match(/^data:([^;]+);base64,(.+)$/);
      if (!matches) throw new TRPCError({ code: 'BAD_REQUEST', message: 'Invalid image data' });
      const mimeType = matches[1];
      const buffer = Buffer.from(matches[2], 'base64');
      const ext = mimeType.split('/')[1] || 'jpg';
      const filename = input.filename || `product-${input.productId}-${Date.now()}.${ext}`;
      const key = `products/${input.productId}/${filename}`;
      const { url } = await storagePut(key, buffer, mimeType);
      return { url, key };
    }),

  upsertVariant: adminProcedure
    .input(z.object({
      id: z.number().optional(),
      productId: z.number(),
      name: z.string().min(1),
      sku: z.string().optional(),
      price: z.string(),
      salePrice: z.string().optional(),
      cog: z.string().optional(),
      attributes: z.record(z.string(), z.string()).default({}),
      image: z.string().optional(),
      galleryImages: z.array(z.string()).default([]),
      weight: z.string().optional(),
      isActive: z.boolean().default(true),
      // P7: Pre-order fields
      preOrderEnabled: z.boolean().default(false),
      preOrderLimit: z.number().int().min(0).default(0),
    }))
    .mutation(async ({ input }) => {
      const { getDb, generateSku, checkSkuUnique } = await import('./db');
      const { productVariants, products } = await import('../drizzle/schema');
      const { eq } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR' });
      const { id, ...data } = input;
      // P11: Auto-generate SKU if not provided
      let sku = data.sku?.trim() || '';
      if (!sku) {
        const [prod] = await db.select({ slug: products.slug }).from(products).where(eq(products.id, data.productId)).limit(1);
        const attrValues = Object.values(data.attributes || {});
        sku = await generateSku(prod?.slug || String(data.productId), attrValues, id);
      }
      // P11: Check SKU uniqueness (skip check for WC-synced variants where duplicates are expected)
      const conflictId = await checkSkuUnique(sku, id);
      if (conflictId) {
        throw new TRPCError({ code: 'CONFLICT', message: `SKU "${sku}" is already used by variant ID ${conflictId}. Please use a different SKU.` });
      }
      const payload = { ...data, sku };
      if (id) {
        await db.update(productVariants).set(payload as any).where(eq(productVariants.id, id));
        return { id, sku };
      } else {
        const [result] = await db.insert(productVariants).values(payload as any);
        return { id: (result as any).insertId, sku };
      }
    }),

