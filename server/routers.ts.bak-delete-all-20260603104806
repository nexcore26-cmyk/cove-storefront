const shippingRouter = router({
  zones: publicProcedure.query(() => getShippingZones()),

  /**
   * Calculate shipping cost for a given country and order total.
   * Returns available methods with their costs and a recommended method.
   */
  calculate: publicProcedure
    .input(z.object({
      country: z.string().min(1),
      orderTotal: z.number().min(0),
    }))
    .query(async ({ input }) => {
      const zones = await getShippingZones();
      // Find the best matching zone: exact country match first, then wildcard
      const matchingZone = zones.find(z =>
        Array.isArray(z.countries) && z.countries.includes(input.country)
      ) || zones.find(z =>
        !z.countries || (z.countries as string[]).length === 0
      );

      if (!matchingZone) {
        // No zone found — return a default flat rate
        return {
          available: [{ id: 'flat_rate', title: 'Standard Delivery', cost: 2.5, isFree: false }],
          recommended: { id: 'flat_rate', title: 'Standard Delivery', cost: 2.5, isFree: false },
          zoneName: 'Default',
        };
      }

      const methods = (matchingZone.methods || []).filter((m: any) => m.enabled !== false);
      const available = methods.map((m: any) => {
        const rawCost = parseFloat(String(m.cost || '0')) || 0;
        const freeThreshold = m.freeShippingMinAmount ? parseFloat(m.freeShippingMinAmount) : null;
        const isFree = freeThreshold !== null && input.orderTotal >= freeThreshold;
        return {
          id: m.id || m.type || 'flat_rate',
          title: m.title || 'Delivery',
          cost: isFree ? 0 : rawCost,
          isFree,
          freeShippingThreshold: freeThreshold,
        };
      });

      // If no methods, return a sensible default
      if (available.length === 0) {
        available.push({ id: 'flat_rate', title: 'Standard Delivery', cost: 2.5, isFree: false, freeShippingThreshold: null });
      }

      // Recommend the cheapest enabled method
      const recommended = [...available].sort((a, b) => a.cost - b.cost)[0];

