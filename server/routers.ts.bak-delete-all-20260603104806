    .mutation(async ({ input, ctx }) => {
      const { getDb } = await import('./db');
      const { warehouseStock, stockTransfers } = await import('../drizzle/schema');
      const { eq, and, isNull: isNullOp } = await import('drizzle-orm');
      const db = await getDb();
      if (!db) throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'DB unavailable' });
      const condition = input.variantId
        ? and(eq(warehouseStock.warehouseId, input.warehouseId), eq(warehouseStock.variantId, input.variantId))
        : and(eq(warehouseStock.warehouseId, input.warehouseId), eq(warehouseStock.productId, input.productId), isNullOp(warehouseStock.variantId));
      const existing = await db.select().from(warehouseStock).where(condition).limit(1);
      if (existing.length === 0) {
        await db.insert(warehouseStock).values({
          warehouseId: input.warehouseId,
          productId: input.productId,
          variantId: input.variantId ?? null,
          quantity: Math.max(0, input.quantityDelta),
        });
      } else {
        const newQty = Math.max(0, (existing[0].quantity ?? 0) + input.quantityDelta);
        await db.update(warehouseStock).set({ quantity: newQty }).where(condition);
      }
      // For adjustments, use the same warehouse for both from/to; direction is encoded in the reason prefix
      await db.insert(stockTransfers).values({
        fromWarehouseId: input.warehouseId,
        toWarehouseId: input.warehouseId,
        productId: input.productId,
        variantId: input.variantId ?? null,
