var paymentRouter = router({
  /**
   * Initiate a payment for an existing Cove order. The order is already created;
   * this step creates the provider invoice/hosted payment and stores references.
   */
  initiate: publicProcedure.input(z9.object({
    orderId: z9.number(),
    origin: z9.string().url(),
    paymentMethodId: z9.number().int().positive().optional()
  })).mutation(async ({ input }) => {
    const { getDb: getDb2 } = await Promise.resolve().then(() => (init_db(), db_exports));
    const { orders: orders2, orderItems: orderItems2 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
    const { eq: eq7 } = await import("drizzle-orm");
    const { initiatePayment: initiatePayment2 } = await Promise.resolve().then(() => (init_payment(), payment_exports));
    const db = await getDb2();
    if (!db) throw new TRPCError12({ code: "INTERNAL_SERVER_ERROR" });
    const [order] = await db.select().from(orders2).where(eq7(orders2.id, input.orderId)).limit(1);
    if (!order) throw new TRPCError12({ code: "NOT_FOUND", message: "Order not found" });
    const items = await db.select().from(orderItems2).where(eq7(orderItems2.orderId, input.orderId));
    const callbackUrl = `${input.origin}/checkout/callback?orderId=${order.id}`;
    const webhookUrl = `${input.origin}/api/payments/myfatoorah/webhook`;
    const orderTotal = parseFloat(String(order.total));
    const shippingTotal = parseFloat(String(order.shippingCost || 0));
    const discountTotal = parseFloat(String(order.discountAmount || 0));
    const paymentItems = items.map((i) => ({
      name: i.name,
      qty: i.quantity,
      unitPrice: parseFloat(String(i.unitPrice || i.total / i.quantity))
    }));
    const itemSubtotal = paymentItems.reduce((sum2, item) => sum2 + item.qty * item.unitPrice, 0);
    const reconciledItems = discountTotal <= 0 && Math.abs(itemSubtotal + shippingTotal - orderTotal) < 0.01 ? [...paymentItems, ...shippingTotal > 0 ? [{ name: "Shipping", qty: 1, unitPrice: shippingTotal }] : []] : void 0;
    const result = await initiatePayment2({
      orderId: order.id,
      orderNumber: order.orderNumber,
      amount: orderTotal,
      currency: order.currency || "KWD",
      customer: { name: order.customerName || "Customer", email: order.customerEmail, phone: order.customerPhone },
      callbackUrl,
      errorUrl: `${input.origin}/checkout/callback?orderId=${order.id}&error=1`,
      webhookUrl,
      items: reconciledItems,
      paymentMethodId: input.paymentMethodId
    });
    await db.update(orders2).set({
      paymentReference: result.invoiceId || result.gatewayRef,
      gatewayRef: result.invoiceId || result.gatewayRef,
      paymentInvoiceId: result.invoiceId || result.gatewayRef,
      paymentId: result.paymentId,
      paymentMethod: result.gateway,
      paymentProviderData: result.providerData
    }).where(eq7(orders2.id, order.id));
    return {
      paymentUrl: result.paymentUrl,
      gatewayRef: result.gatewayRef,
      invoiceId: result.invoiceId,
      gateway: result.gateway
    };
  }),
  /**
   * Verify payment status after gateway callback. MyFatoorah appends paymentId;
   * when present we verify by PaymentId and persist all returned identifiers.
   */
  verify: publicProcedure.input(z9.object({
    orderId: z9.number(),
    paymentId: z9.string().optional(),
    invoiceId: z9.string().optional()
  })).mutation(async ({ input }) => {
    const { getDb: getDb2 } = await Promise.resolve().then(() => (init_db(), db_exports));
    const { orders: orders2 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
    const { eq: eq7 } = await import("drizzle-orm");
    const { verifyPayment: verifyPayment2, applyPaymentResultToOrder: applyPaymentResultToOrder2 } = await Promise.resolve().then(() => (init_payment(), payment_exports));
    const db = await getDb2();
    if (!db) throw new TRPCError12({ code: "INTERNAL_SERVER_ERROR" });
    const [order] = await db.select().from(orders2).where(eq7(orders2.id, input.orderId)).limit(1);
    if (!order) throw new TRPCError12({ code: "NOT_FOUND", message: "Order not found" });
    const gatewayRef = input.invoiceId || order.paymentInvoiceId || order.gatewayRef || order.paymentReference;
    if (!gatewayRef && !input.paymentId) throw new TRPCError12({ code: "BAD_REQUEST", message: "No payment reference found" });
    const result = await verifyPayment2(String(gatewayRef || input.paymentId), order.paymentMethod, {
      paymentId: input.paymentId,
      invoiceId: input.invoiceId || order.paymentInvoiceId || order.gatewayRef || void 0
    });
    return await applyPaymentResultToOrder2(order.id, result);
  }),
  /**
   * List MyFatoorah methods enabled for the current amount/currency.
   */
  listMethods: publicProcedure.input(z9.object({
    amount: z9.number().positive(),
    currency: z9.string().min(3).max(8).optional()
  })).query(async ({ input }) => {
    const { listMfPaymentMethods: listMfPaymentMethods2 } = await Promise.resolve().then(() => (init_payment(), payment_exports));
    return listMfPaymentMethods2({ amount: input.amount, currency: input.currency || "KWD" });
  }),
  /**
   * Get active payment gateway from store settings.
   */
  getGateway: publicProcedure.query(async () => {
    const { getDb: getDb2 } = await Promise.resolve().then(() => (init_db(), db_exports));
    const { storeSettings: storeSettings2 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
    const db = await getDb2();
    if (!db) return { gateway: "cod" };
    const [settings] = await db.select().from(storeSettings2).limit(1);
    return {
      gateway: settings?.activeGateway || "myfatoorah",
      codEnabled: !!settings?.codEnabled
    };
  })
});
