// server/routers/pos.ts
init_db();
init_schema();
import { TRPCError as TRPCError6 } from "@trpc/server";
import { eq as eq4, and as and4, or as or2, like as like2, inArray, isNull as isNull2, sql as sql2, desc as desc2, gte, lte } from "drizzle-orm";
async function getPosWarehouseId() {
