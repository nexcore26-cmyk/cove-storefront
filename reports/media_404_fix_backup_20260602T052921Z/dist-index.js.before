  drawText(page, "SHIP TO", margin + 220, y, bold, 7, C.stone);
  y -= 14;
  drawText(page, truncate(data.customerName, 35), margin, y, bold, 9);
  drawText(page, truncate(data.customerName, 35), margin + 220, y, bold, 9);
