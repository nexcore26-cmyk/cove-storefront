      name: customers.firstName
    }[input.sortBy];
    const orderByFn = input.sortDir === "asc" ? asc2 : desc3;
    const [rows, [{ total }]] = await Promise.all([
      db.select({
        id: customers.id,
        firstName: customers.firstName,
        lastName: customers.lastName,
        email: customers.email,
        phone: customers.phone,
        country: customers.country,
        area: customers.area,
        totalOrders: customers.totalOrders,
        totalSpent: customers.totalSpent,
        createdAt: customers.createdAt,
        notes: customers.notes
      }).from(customers).where(conditions.length > 0 ? and6(...conditions) : void 0).orderBy(orderByFn(orderByCol)).limit(input.limit).offset(input.offset),
      db.select({ total: count() }).from(customers).where(conditions.length > 0 ? and6(...conditions) : void 0)
    ]);
    return { rows, total };
  }),
  /** Customer detail with order history */
