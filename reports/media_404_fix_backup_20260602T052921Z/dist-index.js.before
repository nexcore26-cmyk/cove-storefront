    const posWarehouseId = await getPosWarehouseId();
    if (!posWarehouseId) throw new TRPCError6({ code: "INTERNAL_SERVER_ERROR", message: "POS warehouse not found" });
    const subtotal = input.items.reduce((sum2, item) => sum2 + item.unitPrice * item.quantity, 0);
    const total = Math.max(0, subtotal + input.shippingCost - input.discountAmount);
    const insufficientItems = [];
    for (const item of input.items) {
