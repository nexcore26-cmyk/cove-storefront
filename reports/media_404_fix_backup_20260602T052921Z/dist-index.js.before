// server/_core/tenantModules.ts
init_schema();
init_db();
import { TRPCError as TRPCError4 } from "@trpc/server";
import { and as and3, eq as eq3 } from "drizzle-orm";
function getTenantId(ctx) {
  const tenantId = ctx.user?.tenantId;
  if (!tenantId) {
    throw new TRPCError4({
      code: "FORBIDDEN",
      message: "Tenant context is required"
    });
  }
  return tenantId;
}
async function requireTenantModule(ctx, moduleKey) {
  const tenantId = getTenantId(ctx);
  const db = await getDb();
  if (!db) {
    throw new TRPCError4({
      code: "INTERNAL_SERVER_ERROR",
      message: "Database unavailable for tenant module check"
    });
  }
  const rows = await db.select({ isEnabled: tenantModules.isEnabled }).from(tenantModules).where(and3(eq3(tenantModules.tenantId, tenantId), eq3(tenantModules.moduleKey, moduleKey))).limit(1);
  if (!rows[0]?.isEnabled) {
    throw new TRPCError4({
      code: "FORBIDDEN",
      message: `Tenant module disabled: ${moduleKey}`
    });
  }
}

