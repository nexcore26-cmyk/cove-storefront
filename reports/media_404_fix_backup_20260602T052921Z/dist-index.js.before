// server/routers/bundles.ts
import { z as z4 } from "zod";
import { TRPCError as TRPCError7 } from "@trpc/server";
init_db();
var adminProcedure3 = protectedProcedure.use(({ ctx, next }) => {
  if (ctx.user.role !== "admin")
    throw new TRPCError7({ code: "FORBIDDEN", message: "Admin access required" });
  return next({ ctx });
});
var bundlesRouter = router({
  /**
   * List all component variants for a given bundle variant.
   * Returns each component with product name, variant name, attributes, image, and qty.
   */
  getItems: publicProcedure.input(z4.object({ bundleVariantId: z4.number() })).query(async ({ input }) => {
    const { bundleItems: bundleItems2, productVariants: productVariants2, products: products2 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
    const { eq: eq7 } = await import("drizzle-orm");
    const db = await getDb();
    if (!db) return [];
    const rows = await db.select({
      id: bundleItems2.id,
      bundleVariantId: bundleItems2.bundleVariantId,
      componentVariantId: bundleItems2.componentVariantId,
      qty: bundleItems2.qty,
      // Component variant fields
      variantName: productVariants2.name,
      variantSku: productVariants2.sku,
      variantImage: productVariants2.image,
      variantAttributes: productVariants2.attributes,
      variantPrice: productVariants2.price,
      variantProductId: productVariants2.productId,
      // Component product fields
      productName: products2.name,
      productSlug: products2.slug
    }).from(bundleItems2).innerJoin(productVariants2, eq7(productVariants2.id, bundleItems2.componentVariantId)).innerJoin(products2, eq7(products2.id, productVariants2.productId)).where(eq7(bundleItems2.bundleVariantId, input.bundleVariantId)).orderBy(bundleItems2.id);
    return rows;
  }),
  /**
   * Admin: replace all bundle items for a variant.
   * Deletes existing items then inserts new ones in a single transaction.
   */
  setItems: adminProcedure3.input(
    z4.object({
      bundleVariantId: z4.number(),
      items: z4.array(
        z4.object({
          componentVariantId: z4.number(),
          qty: z4.number().min(1e-3).default(1)
        })
      )
    })
  ).mutation(async ({ input }) => {
    const { bundleItems: bundleItems2 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
    const { eq: eq7 } = await import("drizzle-orm");
    const db = await getDb();
    if (!db) throw new TRPCError7({ code: "INTERNAL_SERVER_ERROR" });
    await db.delete(bundleItems2).where(eq7(bundleItems2.bundleVariantId, input.bundleVariantId));
    if (input.items.length > 0) {
      await db.insert(bundleItems2).values(
        input.items.map((item) => ({
          bundleVariantId: input.bundleVariantId,
          componentVariantId: item.componentVariantId,
          qty: String(item.qty)
        }))
      );
    }
    return { success: true, count: input.items.length };
  }),
  /**
   * Return the effective stock of a bundle variant in a given warehouse.
   * Effective stock = min(component variant stock × (1/qty)) across all components.
   * If no components are defined, returns null (no bundle items configured).
   * If any component has 0 stock, returns 0 (bundle is out of stock).
   */
  checkStock: publicProcedure.input(
    z4.object({
      bundleVariantId: z4.number(),
      warehouseId: z4.number()
    })
  ).query(async ({ input }) => {
    const { bundleItems: bundleItems2, warehouseStock: warehouseStock2 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
    const { eq: eq7, and: and7, isNull: isNull3 } = await import("drizzle-orm");
    const db = await getDb();
    if (!db) return { effectiveStock: null, components: [] };
    const items = await db.select().from(bundleItems2).where(eq7(bundleItems2.bundleVariantId, input.bundleVariantId));
    if (items.length === 0) return { effectiveStock: null, components: [] };
    const componentStocks = [];
    for (const item of items) {
      const qty = parseFloat(String(item.qty));
      const stockRows = await db.select().from(warehouseStock2).where(
        and7(
          eq7(warehouseStock2.warehouseId, input.warehouseId),
          eq7(warehouseStock2.variantId, item.componentVariantId)
        )
      ).limit(1);
      let stock = 0;
      if (stockRows.length > 0) {
        stock = stockRows[0].quantity || 0;
      }
      const availableUnits = qty > 0 ? Math.floor(stock / qty) : 0;
      componentStocks.push({
        componentVariantId: item.componentVariantId,
        qty,
        stock,
        availableUnits
      });
    }
    const effectiveStock = Math.min(...componentStocks.map((c) => c.availableUnits));
    return { effectiveStock, components: componentStocks };
  }),
  /**
   * Admin typeahead: search for variants by product name or variant name.
