      <tr>
        <td style="font-size:13px;color:${mutedColor2};padding:4px 0;">Order #</td>
        <td style="font-size:13px;color:${darkColor2};text-align:right;padding:4px 0;font-weight:600;">${data.orderNumber}</td>
      </tr>
      <tr>
        <td style="font-size:13px;color:${mutedColor2};padding:4px 0;">Customer</td>
        <td style="font-size:13px;color:${darkColor2};text-align:right;padding:4px 0;">${data.customerName}</td>
      </tr>
    </table>
    <h3 style="font-size:14px;font-weight:600;color:${darkColor2};margin:16px 0 8px;">Your Commission Items</h3>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
      <tr style="background:#F5F0E8;">
        <th style="font-size:12px;font-weight:600;color:${darkColor2};padding:8px;text-align:left;">Product</th>
        <th style="font-size:12px;font-weight:600;color:${darkColor2};padding:8px;text-align:center;">Qty</th>
        <th style="font-size:12px;font-weight:600;color:${darkColor2};padding:8px;text-align:right;">Unit Price</th>
        <th style="font-size:12px;font-weight:600;color:${darkColor2};padding:8px;text-align:right;">%</th>
        <th style="font-size:12px;font-weight:600;color:${brandColor2};padding:8px;text-align:right;">Commission</th>
      </tr>
      ${itemsRows}
    </table>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:12px;">
      <tr>
        <td style="font-size:13px;color:${mutedColor2};padding:4px 0;">Order Subtotal</td>
        <td style="font-size:13px;color:${darkColor2};text-align:right;padding:4px 0;">${parseFloat(String(data.subtotal)).toFixed(3)} ${currency}</td>
      </tr>
      <tr>
        <td style="font-size:15px;font-weight:700;color:${darkColor2};padding:12px 0 4px;border-top:2px solid ${brandColor2};">Your Commission</td>
        <td style="font-size:15px;font-weight:700;color:${brandColor2};text-align:right;padding:12px 0 4px;border-top:2px solid ${brandColor2};">${parseFloat(String(data.commissionTotal)).toFixed(3)} ${currency}</td>
      </tr>
    </table>
    <p style="margin:24px 0 0;font-size:13px;color:${mutedColor2};">
      View this order in your
      <a href="https://admin.coveinterior.com/vendor/login" style="color:${brandColor2};">Vendor Portal \u2192</a>
    </p>
  `;
  try {
    await resend.emails.send({
      from: ENV.emailFrom,
      to: data.vendorEmail,
      subject: `\u{1F4BC} New Order #${data.orderNumber} \u2014 Commission ${parseFloat(String(data.commissionTotal)).toFixed(3)} ${currency} | Cove Interior`,
      html: emailWrapper(body)
