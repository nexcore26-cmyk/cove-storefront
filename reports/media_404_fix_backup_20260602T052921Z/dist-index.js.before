      variantSku: productVariants2.sku,
      variantImage: productVariants2.image,
      variantAttributes: productVariants2.attributes,
      variantPrice: productVariants2.price,
      productId: products2.id,
      productName: products2.name,
      productSlug: products2.slug
    }).from(productVariants2).innerJoin(products2, eq7(products2.id, productVariants2.productId)).where(
      or4(
        like4(products2.name, q),
        like4(productVariants2.name, q),
        like4(productVariants2.sku, q)
      )
    ).limit(20);
    return rows;
