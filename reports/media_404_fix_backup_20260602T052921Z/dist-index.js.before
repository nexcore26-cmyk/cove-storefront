   */
  searchVariants: adminProcedure3.input(z4.object({ query: z4.string().min(1) })).query(async ({ input }) => {
    const { productVariants: productVariants2, products: products2 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
    const { like: like4, or: or4, eq: eq7 } = await import("drizzle-orm");
    const db = await getDb();
    if (!db) return [];
    const q = `%${input.query}%`;
    const rows = await db.select({
      variantId: productVariants2.id,
