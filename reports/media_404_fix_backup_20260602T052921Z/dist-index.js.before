  const [wh] = await db.select({ id: warehouses.id }).from(warehouses).where(eq4(warehouses.code, "POS")).limit(1);
  return wh?.id ?? null;
}
var posRouter = router({
  /** List all POS categories (brass + main with channel pos/both) */
  categories: posProcedure2.query(async () => {
    const db = await getDb();
    if (!db) return [];
    const posCats = await db.select({
      id: categories.id,
      name: categories.name,
      slug: categories.slug,
      image: categories.image,
      wcSource: categories.wcSource
    }).from(categories).where(inArray(categories.channel, ["pos", "both"])).orderBy(categories.name);
    return posCats;
  }),
  /** List products for a given category, with POS stock level */
  products: posProcedure2.input(z3.object({
    categoryId: z3.number().optional(),
    search: z3.string().optional(),
    limit: z3.number().min(1).max(200).default(100),
    offset: z3.number().default(0)
  })).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return { items: [], total: 0 };
    const posWarehouseId = await getPosWarehouseId();
    const conditions = [eq4(products.status, "active")];
    if (input.categoryId) {
      const [cat] = await db.select({ name: categories.name }).from(categories).where(eq4(categories.id, input.categoryId)).limit(1);
      if (cat) {
        const sameName = await db.select({ id: categories.id }).from(categories).where(and4(
          like2(categories.name, cat.name),
          inArray(categories.channel, ["pos", "both"])
        ));
        const catIds = sameName.map((c) => c.id);
        if (catIds.length > 0) {
          conditions.push(inArray(products.categoryId, catIds));
        } else {
          conditions.push(eq4(products.categoryId, input.categoryId));
        }
      } else {
        conditions.push(eq4(products.categoryId, input.categoryId));
      }
    } else {
      const posCats = await db.select({ id: categories.id }).from(categories).where(inArray(categories.channel, ["pos", "both"]));
      if (posCats.length > 0) {
