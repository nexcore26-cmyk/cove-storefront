      <td style="font-size:13px;color:${darkColor2};padding:8px 0;">${item.productName}</td>
      <td style="font-size:13px;color:${darkColor2};padding:8px 0;text-align:center;">${item.quantity}</td>
      <td style="font-size:13px;color:${darkColor2};padding:8px 0;text-align:right;">${parseFloat(String(item.unitPrice)).toFixed(3)} ${currency}</td>
      <td style="font-size:13px;color:${darkColor2};padding:8px 0;text-align:right;">${item.commissionPercent}%</td>
      <td style="font-size:13px;color:${brandColor2};padding:8px 0;text-align:right;font-weight:600;">${(item.unitPrice * item.quantity * item.commissionPercent / 100).toFixed(3)} ${currency}</td>
    </tr>
  `
  ).join("");
