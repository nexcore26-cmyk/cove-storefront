import { createHmac, randomBytes, timingSafeEqual } from "crypto";
import { TRPCError as TRPCError3 } from "@trpc/server";
var TOKEN_TTL_MS = 12 * 60 * 60 * 1e3;
var tokenInput = z.object({ token: z.string().min(32) });
function getTokenSecret() {
  return process.env.SESSION_SECRET || process.env.COOKIE_SECRET || process.env.JWT_SECRET || "cove-vendor-portal-dev-secret";
}
function signPayload(payload) {
  return createHmac("sha256", getTokenSecret()).update(payload).digest("base64url");
}
function issueVendorToken(vendor) {
  const payload = JSON.stringify({
    vendorId: vendor.id,
    tenantId: vendor.tenantId,
    nonce: randomBytes(16).toString("hex"),
    exp: Date.now() + TOKEN_TTL_MS
  });
  const encoded = Buffer.from(payload, "utf8").toString("base64url");
  return `${encoded}.${signPayload(encoded)}`;
}
function parseVendorToken(token) {
  const [encoded, signature] = token.split(".");
  if (!encoded || !signature) {
    throw new TRPCError3({ code: "UNAUTHORIZED", message: "Vendor session is invalid" });
  }
  const expected = signPayload(encoded);
  const actualBuffer = Buffer.from(signature);
  const expectedBuffer = Buffer.from(expected);
  if (actualBuffer.length !== expectedBuffer.length || !timingSafeEqual(actualBuffer, expectedBuffer)) {
    throw new TRPCError3({ code: "UNAUTHORIZED", message: "Vendor session is invalid" });
  }
  let payload;
  try {
    payload = JSON.parse(Buffer.from(encoded, "base64url").toString("utf8"));
  } catch {
    throw new TRPCError3({ code: "UNAUTHORIZED", message: "Vendor session is invalid" });
  }
  if (!payload.exp || Date.now() > payload.exp) {
    throw new TRPCError3({ code: "UNAUTHORIZED", message: "Vendor session has expired" });
  }
  if (!Number.isInteger(payload.vendorId) || !Number.isInteger(payload.tenantId)) {
    throw new TRPCError3({ code: "UNAUTHORIZED", message: "Vendor session is invalid" });
  }
  return { vendorId: payload.vendorId, tenantId: payload.tenantId };
}
async function requireVendorsModuleForTenant(tenantId) {
  const db = await getDb();
  if (!db) throw new TRPCError3({ code: "INTERNAL_SERVER_ERROR", message: "DB unavailable" });
  const rows = await db.select({ isEnabled: tenantModules.isEnabled }).from(tenantModules).where(and2(eq2(tenantModules.tenantId, tenantId), eq2(tenantModules.moduleKey, "vendors"))).limit(1);
  if (!rows[0]?.isEnabled) {
    throw new TRPCError3({ code: "FORBIDDEN", message: "Vendor module is disabled" });
  }
}
async function authenticateVendor(token) {
  const db = await getDb();
  if (!db) throw new TRPCError3({ code: "INTERNAL_SERVER_ERROR", message: "DB unavailable" });
  const session = parseVendorToken(token);
  await requireVendorsModuleForTenant(session.tenantId);
  const [vendor] = await db.select().from(vendors).where(and2(eq2(vendors.id, session.vendorId), eq2(vendors.tenantId, session.tenantId))).limit(1);
  if (!vendor || !vendor.isActive || vendor.status !== "active") {
    throw new TRPCError3({ code: "UNAUTHORIZED", message: "Vendor session is no longer active" });
  }
