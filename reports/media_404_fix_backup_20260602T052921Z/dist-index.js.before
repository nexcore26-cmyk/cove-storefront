      lastName: customers.lastName,
      email: customers.email,
      phone: customers.phone
    }).from(customers).where(
      or2(
        like2(customers.firstName, `%${input.query}%`),
        like2(customers.lastName, `%${input.query}%`),
        like2(customers.email, `%${input.query}%`),
        like2(customers.phone, `%${input.query}%`)
