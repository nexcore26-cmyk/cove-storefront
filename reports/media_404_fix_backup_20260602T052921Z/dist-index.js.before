        like3(customers.firstName, q),
        like3(customers.lastName, q),
        like3(customers.email, q),
        like3(customers.phone, q)
      ));
    }
    if (input.country?.trim()) {
      conditions.push(eq6(customers.country, input.country.trim().toUpperCase()));
    }
    const orderByCol = {
      totalSpent: customers.totalSpent,
      totalOrders: customers.totalOrders,
