  }),
  /** Get variants for a variable product */
  variants: posProcedure2.input(z3.object({ productId: z3.number() })).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return [];
    const posWarehouseId = await getPosWarehouseId();
    const variants = await db.select().from(productVariants).where(
      and4(
        eq4(productVariants.productId, input.productId),
        eq4(productVariants.isActive, true)
      )
    );
    if (!posWarehouseId || variants.length === 0) return variants.map((v) => ({ ...v, posStock: null }));
    const variantIds = variants.map((v) => v.id);
    const stockRows = await db.select({
      variantId: warehouseStock.variantId,
      quantity: warehouseStock.quantity
    }).from(warehouseStock).where(
      and4(
        eq4(warehouseStock.warehouseId, posWarehouseId),
        inArray(warehouseStock.variantId, variantIds)
      )
    );
    const stockMap = new Map(stockRows.map((s) => [s.variantId, s.quantity]));
    return variants.map((v) => ({ ...v, posStock: stockMap.get(v.id) ?? null }));
