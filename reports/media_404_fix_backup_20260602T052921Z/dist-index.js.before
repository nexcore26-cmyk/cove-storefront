  drawText(page, "QTY", margin + contentWidth - 180, y + 2, bold, 7.5, C.white);
  drawText(page, "UNIT PRICE", margin + contentWidth - 130, y + 2, bold, 7.5, C.white);
  drawText(page, "TOTAL", margin + contentWidth - 54, y + 2, bold, 7.5, C.white);
